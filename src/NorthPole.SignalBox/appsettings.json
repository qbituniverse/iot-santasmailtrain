{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "SignalBox": {
    "Mqtt": {
      "Host": "localhost",
      "Port": 1883,
      "ClientId": "signalbox"
    },
    "Train": {
      "Mode": "Simulated",
      "BluetoothAdapter": "hci0",
      "BlueGigaPort": "/dev/ttyACM0",
      "MotorPort": 0,
      "LightPort": 1,
      "ReverseDirection": false,
      "CruiseSpeed": 45,
      "ApproachSpeed": 25,
      "MaxSpeed": 70,
      "LowBatteryPercent": 15
    },
    "Trackside": {
      "Mode": "Simulated",
      "NorthPoleSensor": { "Kind": "Magnet", "Pin": 17, "ActiveLow": true },
      "HomeSensor": { "Kind": "Ultrasonic", "Pin": 27, "TriggerPin": 22, "DetectWithinCm": 8 },
      "RedLedPin": 23,
      "GreenLedPin": 24,
      "ServoEnabled": true,
      "ServoPwmChip": 0,
      "ServoPwmChannel": 0,
      "FlagDownDuty": 0.05,
      "FlagUpDuty": 0.075,
      "Board": { "Enabled": true, "RsPin": 5, "EnablePin": 6, "D4Pin": 13, "D5Pin": 19, "D6Pin": 26, "D7Pin": 21 },
      "SimulatedTravelSeconds": 6
    },
    "Run": {
      "LoadingSeconds": 3,
      "ArrivalTimeoutSeconds": 60,
      "MaxWaitAtNorthPoleSeconds": 90,
      "StatePublishSeconds": 10
    }
  }
}
