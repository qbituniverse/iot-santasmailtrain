{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:80",

  "NorthPole": {
    "DataDirectory": "data",
    "WishesPerDay": 1,

    "Family": [
      { "Id": "limelight-mole", "Name": "Limelight", "Age": 7, "AboutMe": "Loves comets, tunnels and drawing maps of underground castles. Learning to ride a bike." },
      { "Id": "quibble-otter", "Name": "Quibble", "Age": 5, "AboutMe": "Dinosaurs, diggers and anything LEGO." }
    ],

    "Santa": {
      "Brain": "Claude",
      "Model": "claude-sonnet-5-5",
      "RememberWishes": 5,
      "Language": "British English",
      "FamilyLore": "Our elf on the shelf is called Bramblesnoot and he is very cheeky. The family tortoise is Captain Puddle. Every Christmas Eve we leave out a mince pie and a carrot."
    },

    "Voice": {
      "Mode": "Piper",
      "PiperUrl": "http://localhost:5000",
      "LengthScale": 1.15,
      "PlayOnStation": true,
      "PlayCommand": "aplay -q",
      "CastTo": "",
      "CastVolumeAbove": 0.15,
      "CastVolumeMin": 0.35,
      "CastVolumeMax": 0.7,
      "ArrivalSound": "sounds/arrival.wav"
    },

    "Qr": {
      "BaseUrl": "http://np.local",
      "BaseplateStuds": 32
    },

    "Elves": {
      "Pin": "1225"
    },

    "Mqtt": {
      "EmbeddedBroker": true,
      "Port": 1883
    }
  }
}
