[Unit]
Description=North Pole signal box (LEGO train + trackside GPIO)
After=network-online.target bluetooth.target
Wants=network-online.target bluetooth.target

[Service]
# Root keeps GPIO, PWM (sysfs) and BlueZ's D-Bus API (or the BLED112 serial port) simple on a hobby box.
# To harden: run as your user in the gpio + bluetooth groups (dialout for a BLED112) and add a udev rule for /sys/class/pwm.
User=root
WorkingDirectory=/opt/northpole/signalbox
ExecStart=/opt/dotnet/dotnet /opt/northpole/signalbox/NorthPole.SignalBox.dll
Environment=DOTNET_ROOT=/opt/dotnet
Environment=DOTNET_ENVIRONMENT=Pi
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
