<?xml version="1.0" encoding="utf-8"?>
<!-- Every package here comes from nuget.org. Clearing the inherited sources keeps restore from
     stalling on private feeds in the machine's user-level NuGet config. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
